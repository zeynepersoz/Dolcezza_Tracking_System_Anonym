# Dolcezza Tracking System — ortam yapılandırması
# Bu dosyayı `.env` olarak kopyalayın ve yalnızca ELİNİZDEKİ kanalı doldurun.
# `python3 cli.py doctor` hangi kanalın canlı olduğunu satır satır söyler.
#
#   cp .env.example .env && $EDITOR .env
#
# GLS tek bir "API" vermez; birbirinden BAĞIMSIZ kanallar vardır. Ayrıntı ve
# GLS'ten ne isteneceği: docs/IT_TALEP_NOTU.md

# mock -> yerel sahte sunucu (kimlik gerekmez; uvicorn gls_api.mock_server:app --port 8788)
# test -> GLS test ortamı
# prod -> canlı ortam
GLS_MODE=mock

# --- A) GLS ShipIT REST — etiket + takip + POD (PDF) ------------------------
# Taban URL müşteriye özeldir, örn. https://<host>.gls-group.eu:8443/backend
SHIPIT_BASE_URL=
SHIPIT_USERNAME=
SHIPIT_PASSWORD=
# "<müşteri no> <depo kodu>" biçimi, örn. "276a0b1c IES". Yalnızca etiket için zorunlu.
SHIPIT_CONTACT_ID=

# --- B) GLS Track & Trace SOAP — sadece takip + POD ------------------------
# Uç nokta grup çapında sabittir; kimlik = gls-group.eu Uni-Portal kullanıcısı.
TT_ENDPOINT=https://www.gls-group.eu/276-I-PORTAL-WEBSERVICE/services/Tracking
TT_USERNAME=
TT_PASSWORD=

# --- C) GLS Netherlands REST — etiket ------------------------------------
# API anahtarı YOKTUR; kimlik JSON gövdesinde gider. Şifre en fazla 20 karakter.
# Test: https://api.gls.nl/test/v1/api   Prod: https://api.gls.nl/v1/api
NL_BASE_URL=https://api.gls.nl/v1/api
NL_USERNAME=
NL_PASSWORD=
NL_CUSTOMER_NO=
# C1) GLS NL Track & Trace — sadece takip (etiket API'sinden AYRI host).
NL_TT_BASE_URL=https://api.gls.nl/tt/V1
# C1b) GLS NL POD ucu — üçüncü ayrı host; kimlik doğrulaması YOKTUR.
NL_POD_BASE_URL=https://apm.gls.nl

# --- E) GLS Grup geçidi — OAuth 2.0 + Track & Trace v1 --------------------
# dev-portal.gls-group.net'te açılan "App"in API Key/Secret'i. Klasik ShipIT'ten
# farklı: önce token alınır, sonra ortak geçit api.gls-group.net üzerinden çağrılır.
# Sadece TAKİP (10 numara/istek, günlük 500 istek). POD ShipIT-Farm'dan gelir.
GLSG_TOKEN_URL=https://api.gls-group.net/oauth2/v2/token
GLSG_BASE_URL=https://api.gls-group.net
GLSG_CLIENT_ID=
GLSG_CLIENT_SECRET=
GLSG_SCOPE=all

# --- D) Sentez / BlueCherry MSSQL — takip numaralarının birincil kaynağı ---
MSSQL_SERVER=
MSSQL_PORT=1434
MSSQL_DATABASE=
MSSQL_USERNAME=
MSSQL_PASSWORD=
# Sıralı sezon görünümleri, virgülle. Yeni sezon sona eklenir.
MSSQL_SEASON_VIEWS=
ERP_WRITEBACK_ENABLED=1
# erp = Sentez canlı sorgu | book = yerel adres defteri (mock/test)
ADDRESS_SOURCE=erp

# --- Arayüz / takip tarayıcısı -------------------------------------------
UI_LANG=tr
TRACKER_INTERVAL_MINUTES=15
TRACKER_MAX_PER_TICK=600
TRACKER_MAX_POD_PER_TICK=40
TRACKER_ALERT_HOURS=6
ERP_SYNC_INTERVAL_MINUTES=60

# --- Günlük özet bildirimi ---------------------------------------------
NOTIFY_ENABLED=0
NOTIFY_RECIPIENTS=
NOTIFY_HOURS=9,18
NOTIFY_STALE_DAYS=7
NOTIFY_PANEL_URL=

# --- POD gelmedi, GLS'e sor (mail DIŞARIYA gider) ---------------------
GLS_INQUIRY_ENABLED=0
GLS_INQUIRY_RECIPIENTS=klantenservice@gls-netherlands.com
GLS_INQUIRY_WAIT_DAYS=7

# --- Bildirim kanalları (Microsoft Graph mail) ------------------------
MAIL_TENANT_ID=
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_SENDER=

# --- OpenWA WhatsApp bildirimleri ------------------------------------
OPENWA_ENABLED=1
OPENWA_URL=http://192.0.2.10:2785
OPENWA_SESSION_ID=
OPENWA_API_KEY=
OPENWA_CHAT_ID=
OPENWA_START_DATE=2026-08-21

# --- Kimlik doğrulama (panel oturumları) ----------------------------
# Boş bırakılırsa diske sabitlenir (~/.gls_pod/session_key).
AUTH_SECRET_KEY=
AUTH_SESSION_MINUTES=20
AUTH_REFRESH_DAYS=30
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=
# prod'da HTTPS arkasındaysa true olmalı.
AUTH_COOKIE_SECURE=true
